# 宿主 nginx 虚拟主机：qianzhang.aicnpor.cn
# 反代到本机 8088（开放签 web 容器），由宿主机 nginx 做 TLS 终止。
# 证书由 certbot 申请（deploy_to_server.py 步骤 6 在签发前先保证证书存在），
# 本文件为完整静态配置（80 + 443 全含），可重复部署、安全覆盖。

server {
    listen 80;
    server_name qianzhang.aicnpor.cn;
    # 允许 ACME http-01 挑战通过（certbot --webroot 使用）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name qianzhang.aicnpor.cn;
    ssl_certificate     /etc/letsencrypt/live/qianzhang.aicnpor.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qianzhang.aicnpor.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5:!RC4:!DHE;
    ssl_prefer_server_ciphers on;
    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
