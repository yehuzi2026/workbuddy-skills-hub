# 复制本文件为 .env 并填入真实值（.env 切勿提交到 git / 公开仓库）
# ===== 必填 =====
# SCNet 云端 OpenAI 兼容 API Key（在 api.scnet.cn 控制台获取）
SCNET_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 可选 =====
# 云端视觉 OCR 兜底（智谱 GLM-4V）。仅当本地 RapidOCR 不可用且服务器有外网时生效。
# 纯内网 / SCNet 容器部署时留空即可，OCR 走本地 RapidOCR。
ZHIPU_API_KEY=

# 覆盖 SCNet 推理 base_url（私有化 vLLM 部署 Llama-3-70B 时改成 http://<IP>:10304/v1）
SCNET_BASE_URL=https://api.scnet.cn/api/llm/v1

# 经验库（自我净化记忆）SQLite 路径。默认 ./experience.db；Docker 下已设为 /data/experience.db
# SELF_IMPROVE_DB=/data/experience.db
